  "claims": [
    {
      "id": "c1",
      "claim": "Inside a ballpoint pen's plastic barrel is a thin tube (the refill) that holds the ink.",
      "beat": "explode",
      "source": "https://home.howstuffworks.com/pen3.htm",
      "confidence": "high"
    },
    {
      "id": "c2",
      "claim": "Ballpoint pen ink is thick and oil-based — far more viscous than water or fountain-pen ink (oil-based ballpoint inks are typically around 1,000–20,000 centipoise; water is about 1).",
      "beat": "explode",
      "source": "https://home.howstuffworks.com/pen3.htm ; US patent 5,990,201 (image-ppubs.uspto.gov/dirsearch-public/print/downloadPdf/5990201)",
      "confidence": "high",
      "note": "Some modern 'low-viscosity' oil inks are thinner (300–3,000 cP) but still far thicker than water."
    },
    {
      "id": "c3",
      "claim": "The tip of a common ballpoint pen holds a metal ball about one millimetre wide (a 'medium' point is a 1.0 mm ball).",
      "beat": "explode",
      "source": "MoMA collection, Bic Cristal (moma.org/collection/works/82141): '1 mm ball'; https://en.wikipedia.org/wiki/Bic_Cristal",
      "confidence": "high",
      "note": "Ball sizes range from about 0.5 to 1.6 mm; materials include tungsten carbide, steel and brass."
    },
    {
      "id": "c4",
      "claim": "The ball sits in a socket at the tip; as it rolls, ink from the refill coats the ball and the ball carries that ink onto the paper.",
      "beat": "key-part",
      "source": "https://home.howstuffworks.com/pen3.htm ; Princeton fluid-mechanics paper (princeton.edu/~stonelab/Teaching/PaulReverdy%20finalPaper.pdf)",
      "confidence": "high"
    },
    {
      "id": "c5",
      "claim": "When the pen isn't writing, the ball blocks the opening at the tip, which also limits air reaching the ink so it doesn't dry out.",
      "beat": "key-part",
      "source": "https://home.howstuffworks.com/pen3.htm",
      "confidence": "high",
      "note": "'Like a tiny cork' is an analogy, not a literal seal."
    },
    {
      "id": "c6",
      "claim": "Ballpoint ink is too viscous to flow out freely on its own; it flows when the rolling ball draws it out.",
      "beat": "payoff",
      "source": "Bureau of Indian Standards, Ballpoint Pen document (bis.gov.in/wp-content/uploads/2023/08/Ballpoint-Pen-16.pdf): 'the ink does not flow out of the pen freely due to its viscous nature'",
      "confidence": "high"
    }
  ],
