  "beats": [
    {
      "id": "hook",
      "speaker": "pip",
      "voiceover": "Why doesn't your pen leak?",
      "on_screen_text": "Why doesn't it LEAK?",
      "visual": {
        "skill": "render-3d-explainer",
        "shot": "establish"
      },
      "character": {
        "placement": "full",
        "expression": "curious"
      }
    },
    {
      "id": "fly-in",
      "speaker": "pip",
      "voiceover": "Okay but… WHY though? Let's fly inside and find out. The secret is hiding right down at the tip.",
      "visual": {
        "skill": "render-3d-explainer",
        "shot": "fly-in",
        "target": "tip",
        "callouts": []
      },
      "character": {
        "placement": "corner",
        "expression": "excited"
      }
    },
    {
      "id": "explode",
      "speaker": "pip",
      "voiceover": "Here's everything in there. A see-through plastic barrel. A thin tube full of thick, oily ink. And at the very end, a tiny metal ball, about one millimetre wide.",
      "on_screen_text": "What's inside",
      "visual": {
        "skill": "render-3d-explainer",
        "shot": "explode",
        "explode": 1,
        "callouts": [
          "barrel",
          "ink",
          "ball"
        ]
      },
      "character": {
        "placement": "corner",
        "expression": "surprised"
      }
    },
    {
      "id": "key-part",
      "speaker": "pip",
      "voiceover": "That ball sits in a snug little socket. When you write, it rolls, grabs ink from inside, and paints it onto the paper. When you stop writing, it just sits there and blocks the opening, like a tiny cork.",
      "on_screen_text": "The ball is the secret",
      "visual": {
        "skill": "render-3d-explainer",
        "shot": "focus",
        "target": "ball",
        "explode": 0,
        "callouts": [
          "ball",
          "tip"
        ]
      },
      "character": {
        "placement": "corner",
        "expression": "thinking"
      }
    },
    {
      "id": "payoff",
      "speaker": "pip",
      "voiceover": "So the ball is the lid! And the ink is way too thick to drip out on its own. No rolling, no leaking.",
      "on_screen_text": "No rolling = no leaking",
      "visual": {
        "skill": "render-3d-explainer",
        "shot": "reassemble"
      },
      "character": {
        "placement": "full",
        "expression": "excited"
      }
    }
  ],
