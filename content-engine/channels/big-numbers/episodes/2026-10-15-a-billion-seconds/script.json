    {
      "id": "c1",
      "claim": "A billion is 1,000,000,000 (a thousand million, the short-scale billion used in English today).",
      "beat": "hook",
      "source": "https://en.wikipedia.org/wiki/Billion",
      "confidence": "high"
    },
    {
      "id": "c2",
      "claim": "A million seconds is about eleven and a half days (1,000,000 ÷ 86,400 s per day = 11.57 days).",
      "beat": "setup",
      "source": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(time) (1 megasecond ≈ 11.6 days); a day is 86,400 s",
      "confidence": "high"
    },
    {
      "id": "c3",
      "claim": "On a first birthday a stopwatch started at birth reads about 31.5 million seconds (one year = 365.25 × 86,400 = 31,557,600 s; 31.5–31.6 million for a 365- or 366-day year).",
      "beat": "story",
      "source": "https://en.wikipedia.org/wiki/Julian_year_(astronomy) (365.25 days of 86,400 s = 31,557,600 s)",
      "confidence": "high",
      "note": "Shown on screen as \"31.5 million\"."
    },
    {
      "id": "c4",
      "claim": "By age ten it has passed 300 million seconds (10 × 31,557,600 ≈ 315.6 million).",
      "beat": "story",
      "source": "Arithmetic from the Julian-year length: https://en.wikipedia.org/wiki/Julian_year_(astronomy)",
      "confidence": "high",
      "note": "Shown on screen as \"300,000,000\" (it has passed that)."
    },
    {
      "id": "c5",
      "claim": "At age twenty-one it is past 660 million seconds (21 × 31,557,600 ≈ 662.7 million).",
      "beat": "story",
      "source": "Arithmetic from the Julian-year length: https://en.wikipedia.org/wiki/Julian_year_(astronomy)",
      "confidence": "high",
      "note": "Shown on screen as \"660,000,000\"."
    },
    {
      "id": "c6",
      "claim": "At age thirty it reads around 947 million seconds (30 × 31,557,600 = 946,728,000).",
      "beat": "story",
      "source": "Arithmetic from the Julian-year length: https://en.wikipedia.org/wiki/Julian_year_(astronomy)",
      "confidence": "high",
      "note": "Shown on screen as \"947 million\" (946.7 million rounded)."
    },
    {
      "id": "c7",
      "claim": "A billion seconds is about 31.7 years, so it is reached a few months (about 3.7) before a 32nd birthday.",
      "beat": "twist",
      "source": "https://en.wikipedia.org/wiki/Orders_of_magnitude_(time) (1 gigasecond ≈ 31.7 years); 1,000,000,000 ÷ 31,557,600 = 31.69",
