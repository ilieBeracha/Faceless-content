      "id": "c2",
      "claim": "Each GPS satellite carries atomic clocks.",
      "beat": "clue",
      "source": "https://www.gps.gov/systems/gps/space/ ; Ashby, N. (2003) 'Relativity in the Global Positioning System', Living Reviews in Relativity 6:1",
      "confidence": "high"
    },
    {
      "id": "c3",
      "claim": "Relativity predicts clocks run faster where gravity is weaker (general relativity) and slower when moving fast (special relativity).",
      "beat": "story",
      "source": "Ashby 2003, Living Reviews in Relativity 6:1; Ohio State Univ. Astronomy 162 (R. Pogge), 'Real-World Relativity: The GPS Navigation System'",
      "confidence": "high"
    },
    {
      "id": "c4",
      "claim": "Weaker gravity at orbit makes GPS clocks gain about 45 microseconds a day; their orbital speed makes them lose about 7, so they gain about 38 microseconds a day overall.",
      "beat": "story",
      "source": "R. Pogge, Ohio State Univ. Astronomy 162, 'Real-World Relativity: The GPS Navigation System' (45 − 7 = 38 µs/day); Ashby 2003",
      "confidence": "high",
      "note": "On screen: \"+45 µs a day\", \"-7 µs a day\", \"+38 µs a day\"."
    },
