{
  "name": "Wren",
  "summary": "Pencil-sketch person with a bun and glasses",
  "model": {
    "rig": "stick-figure",
    "params": {
      "head": "#e9c9a0",
      "line": "#2b2622",
      "line_width": 5,
      "head_size": 1.1,
      "hair": "bun",
      "hair_color": "#5a3825",
      "body_style": "stick",
      "body_color": "#d9b97e",
      "accessory": "glasses",
      "accessory_color": "#2b2622"
    },
    "expressions": {
      "neutral": {
        "eye_scale": 1,
        "pupil_scale": 1,
        "bounce": 0.3,
        "brow": "flat",
        "mouth_curve": 0.2
      },
      "curious": {
        "eye_scale": 1.15,
        "pupil_scale": 1.1,
        "tilt_deg": 10,
        "look": [
          0.3,
          -0.2
        ],
        "bounce": 0.3,
        "brow": "up",
        "mouth_curve": 0.1
      },
      "excited": {
        "eye_scale": 1.3,
        "pupil_scale": 1.2,
        "bounce": 0.8,
        "brow": "up",
        "mouth_curve": 0.9
      },
      "surprised": {
        "eye_scale": 1.5,
        "pupil_scale": 0.5,
        "bounce": 0.5,
        "brow": "up",
        "mouth_curve": 0
      },
      "thinking": {
        "eye_scale": 0.95,
        "lid": 0.3,
        "tilt_deg": -8,
        "look": [
          -0.4,
          -0.5
        ],
        "bounce": 0.15,
        "brow": "down",
        "mouth_curve": -0.1
      }
    }
  }
}
