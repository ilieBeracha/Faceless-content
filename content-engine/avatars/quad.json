{
  "name": "Quad",
  "summary": "Violet neon square face with pink eyes",
  "model": {
    "rig": "neon-line",
    "params": {
      "line": "#a879ff",
      "glow": "#ff7ad9",
      "backing": "#120a24",
      "shape": "square",
      "line_width": 8
    },
    "expressions": {
      "neutral": {
        "eye_scale": 1,
        "pupil_scale": 1,
        "bounce": 0.3,
        "brow": "flat",
        "mouth_curve": 0.0
      },
      "curious": {
        "eye_scale": 1.15,
        "pupil_scale": 1.1,
        "tilt_deg": 10,
        "look": [
          0.3,
          -0.2
        ],
        "bounce": 0.3,
        "brow": "up",
        "mouth_curve": 0.1
      },
      "excited": {
        "eye_scale": 1.3,
        "pupil_scale": 1.2,
        "bounce": 0.8,
        "brow": "up",
        "mouth_curve": 0.9
      },
      "surprised": {
        "eye_scale": 1.5,
        "pupil_scale": 0.5,
        "bounce": 0.5,
        "brow": "up",
        "mouth_curve": 0
      },
      "thinking": {
        "eye_scale": 0.95,
        "lid": 0.3,
        "tilt_deg": -8,
        "look": [
          -0.4,
          -0.5
        ],
        "bounce": 0.15,
        "brow": "down",
        "mouth_curve": -0.1
      }
    }
  }
}
