# Copy to .env and fill in only what you use. .env is gitignored — never commit keys.

# --- Paid providers (OFF until you choose one; the engine never calls these without you opting in) ---
# ANTHROPIC_API_KEY=            # only for `--llm anthropic` (Claude API drafts scripts/channels without an agent)
# ELEVENLABS_API_KEY=           # future TTS provider (not wired up yet — pick one first)
# OPENAI_API_KEY=               # future TTS provider (not wired up yet — pick one first)

# --- Rendering (optional, machine-specific) ---
# REMOTION_GL=angle             # angle (Mac/GPU, fast) | swangle (software, works anywhere) | egl | vulkan
# REMOTION_BROWSER_EXECUTABLE=  # path to a Chrome Headless Shell; leave empty to let Remotion download one
# RENDER_CONCURRENCY=           # frames rendered in parallel; defaults to half your CPU cores

# --- Tools ---
# PYTHON=python3                # interpreter used to create .venv for the local voice engine
# FFMPEG_PATH=                  # defaults to `ffmpeg` on PATH, then Remotion's bundled ffmpeg
